#!/usr/bin/env bash
#
# Dify 本地调试环境状态检查脚本
# 用法: dev/status-dev-env
#

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

status_running() {
    echo -e "${GREEN}● 运行中${NC}"
}

status_stopped() {
    echo -e "${RED}● 已停止${NC}"
}

# 检查中间件状态
check_middleware() {
    echo ""
    echo "=========================================="
    echo "  中间件服务状态"
    echo "=========================================="
    echo ""

    # 优先使用 podman，兼容 docker
    if command -v podman &> /dev/null; then
        systemctl --user start podman.socket 2>/dev/null || true
        export DOCKER_HOST="unix:///run/user/1000/podman/podman.sock" 2>/dev/null || true
    fi

    if docker compose version &> /dev/null; then
        cd "$PROJECT_ROOT/docker"
        if [[ -f "middleware.env" ]]; then
            docker compose -f docker-compose.middleware.yaml --env-file middleware.env ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || echo "  无法获取中间件状态"
        else
            echo "  middleware.env 不存在"
        fi
    else
        echo "  docker compose 不可用"
    fi
}

# 检查后端状态
check_backend() {
    echo ""
    echo "=========================================="
    echo "  后端服务状态"
    echo "=========================================="
    echo ""

    # Flask API
    echo -n "  Flask API (:5001):    "
    if pgrep -f "flask run.*5001" > /dev/null; then
        status_running
        echo -n "    PID: "
        pgrep -f "flask run.*5001" | head -1
    else
        status_stopped
    fi

    # Celery Worker
    echo -n "  Celery Worker:        "
    if pgrep -f "celery.*worker" > /dev/null; then
        status_running
        echo -n "    PID: "
        pgrep -f "celery.*worker" | head -1
    else
        status_stopped
    fi

    # Celery Beat
    echo -n "  Celery Beat:          "
    if pgrep -f "celery.*beat" > /dev/null; then
        status_running
        echo -n "    PID: "
        pgrep -f "celery.*beat" | head -1
    else
        status_stopped
    fi
}

# 检查前端状态
check_frontend() {
    echo ""
    echo "=========================================="
    echo "  前端服务状态"
    echo "=========================================="
    echo ""

    echo -n "  Frontend (vinext) :3000: "
    if pgrep -f "vinext" > /dev/null; then
        status_running
        echo -n "    PID: "
        pgrep -f "vinext" | head -1
    else
        status_stopped
    fi
}

# 检查端口占用
check_ports() {
    echo ""
    echo "=========================================="
    echo "  端口占用情况"
    echo "=========================================="
    echo ""

    for port in 3000 5001 5432 6379 8080; do
        echo -n "  端口 $port: "
        if ss -tlnp 2>/dev/null | grep -qE ":${port}([^0-9]|$)"; then
            local proc=$(ss -tlnp 2>/dev/null | grep -E ":${port}([^0-9]|$)" | head -1 | awk '{print $6}' | sed 's/.*"\(.*\)".*/\1/')
            echo -e "${GREEN}$proc${NC}"
        else
            echo -e "${RED}未占用${NC}"
        fi
    done
}

# 显示日志文件状态
show_logs() {
    echo ""
    echo "=========================================="
    echo "  日志文件"
    echo "=========================================="
    echo ""

    for log in /tmp/dify-api.log /tmp/dify-worker.log /tmp/dify-beat.log /tmp/dify-web.log; do
        echo -n "  $log: "
        if [[ -f "$log" ]]; then
            local size=$(du -h "$log" 2>/dev/null | cut -f1)
            echo "$size"
        else
            echo "不存在"
        fi
    done
}

# 显示访问地址
show_urls() {
    echo ""
    echo "=========================================="
    echo "  访问地址"
    echo "=========================================="
    echo ""
    echo "  前端: http://localhost:3000"
    echo "  API:  http://localhost:5001"
    echo ""
}

# 主流程
main() {
    echo ""
    echo "=========================================="
    echo "  Dify 本地调试环境状态"
    echo "=========================================="

    check_middleware
    check_backend
    check_frontend
    check_ports
    show_logs
    show_urls
}

main "$@"
