        <mxCell id="mw" value="&lt;b&gt;模型白名单（按成员配置可用模型）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontColor=#1A1A1A;fillColor=#FFF3E8;strokeColor=#FF6A00;strokeWidth=2;align=center;" vertex="1" parent="1">
