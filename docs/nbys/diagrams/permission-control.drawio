        <mxCell id="s4" value="&lt;b&gt;使用入口鉴权&lt;/b&gt;&lt;br&gt;探索：须发布到用户部门&lt;br&gt;/chat：登录 + 部门发布&lt;br&gt;嵌入：合法 embed token" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1A1A1A;fillColor=#FFC690;strokeColor=#FF6A00;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
