        <mxCell id="subtitle" value="开源租户隔离之上叠加部门级访问控制：谁建谁管、发到哪谁用、操作留痕" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="720" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;身份与角色&lt;/b&gt;&lt;br&gt;登录账号&lt;br&gt;租户角色（所有者/管理员/编辑/成员）&lt;br&gt;部门管理员徽章" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1A1A1A;fillColor=#FFF3E8;strokeColor=#FF6A00;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;组织边界&lt;/b&gt;&lt;br&gt;树形部门（最多 10 级）&lt;br&gt;成员归属部门&lt;br&gt;本部门 / 子部门管辖范围" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1A1A1A;fillColor=#FFE8D1;strokeColor=#FF6A00;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="310" y="100" width="220" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;资源控制&lt;/b&gt;&lt;br&gt;工作室 / 知识库归属隔离&lt;br&gt;归属部门 = 谁可编辑&lt;br&gt;发布部门 = 谁可使用" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1A1A1A;fillColor=#FFD7B0;strokeColor=#FF6A00;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
